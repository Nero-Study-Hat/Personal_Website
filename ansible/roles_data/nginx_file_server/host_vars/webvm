### NGINX SERVICE SPECIFIC VARS ###

nginx_file_server:
  name: "nginx_file_server"
  network_backend:
    name: "t3_nginx"
    ipam_options:
    - subnet: "10.100.32.0/29"
      gateway: "10.100.32.1"
    traefik_ips:
      traefik: "10.100.32.2"
      nginx: "10.100.32.3"

host_site_location:
